# fstab OrangeFox Recovery
# Samsung Galaxy Tab S 10.5 LTE (SM-T805 / chagalllte)
# <mount_point>   <fstype>    <device>                                                 <flags>

/boot             emmc        /dev/block/platform/dw_mmc.0/by-name/BOOT                flags=display="Boot";backup=1;flashimg=1
/recovery         emmc        /dev/block/platform/dw_mmc.0/by-name/RECOVERY            flags=display="Recovery";backup=1;flashimg=1
/misc             emmc        /dev/block/platform/dw_mmc.0/by-name/OTA
/system           ext4        /dev/block/platform/dw_mmc.0/by-name/SYSTEM              flags=display="System";backup=1;wipeui
/system_image     emmc        /dev/block/platform/dw_mmc.0/by-name/SYSTEM              flags=display="System Image";flashimg=1
/data             ext4        /dev/block/platform/dw_mmc.0/by-name/USERDATA           flags=display="Data";encryptable=footer
/cache            ext4        /dev/block/platform/dw_mmc.0/by-name/CACHE              flags=display="Cache";wipeui
/modem            emmc        /dev/block/platform/dw_mmc.0/by-name/RADIO              flags=display="Modem";backup=1;flashimg=1
/hidden           ext4        /dev/block/platform/dw_mmc.0/by-name/HIDDEN             flags=display="Hidden";backup=1
/hidden_image     emmc        /dev/block/platform/dw_mmc.0/by-name/HIDDEN             flags=display="Hidden Image";flashimg=1
/efs              ext4        /dev/block/platform/dw_mmc.0/by-name/EFS                flags=display="EFS";backup=1;flashimg=1
/external_sd      vfat        /dev/block/mmcblk1p1    /dev/block/mmcblk1               flags=display="Micro SD Card";storage;wipeui;removable
/usb-otg          vfat        /dev/block/sda1         /dev/block/sda                   flags=display="USB OTG";storage;wipeui;removable
